DISCORD_TOKEN=yourtoken

# Fallback chat model for messages that aren't a tennis lookup — an Ollama instance
# reachable from wherever this bot runs. Defaults below assume Ollama is on the same
# host as the bot; set OLLAMA_HOST to the Pi's LAN address if it isn't.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b